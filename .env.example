# Obsidian configuration. Copy this file, don't move it (the example stays in git):
#
#   cp .env.example .env        # .env is gitignored; never commit it
#
# Who reads .env:
#   - Spring (backend-spring) imports it from the current or parent directory as Java properties
#   - docker compose reads POSTGRES_* from it
#   - scripts/build.sh reads TURNSTILE_SITE_KEY; scripts/prewarm-vt.sh reads VT_API_KEY
#
# Format rules, because both Spring and docker compose parse it:
#   KEY=value on one line. No quotes, no spaces around "=", no "# comment" after a value, and
#   no $(...) or ${...}: paste the generated value itself.
#
# Every key can stay blank for local work with `scripts/build.sh run`; the comment above each one
# says what blank means. For the official demo, fill in everything marked DEMO.

# ---- Origin ---------------------------------------------------------------------------------------

# The one URL people open: http://localhost:3000 locally, https://obsidian.<your-domain> behind the
# named Cloudflare tunnel. Used for the Gmail OAuth redirect and the allowed WebAuthn / WebSocket origin.
PUBLIC_BASE_URL=http://localhost:3000

# WebAuthn relying-party ID: the bare hostname of PUBLIC_BASE_URL (localhost, or obsidian.<your-domain>).
# Passkeys are bound to it: a passkey made for one RP ID never works on another.
RP_ID=localhost

# ---- Database and cache (scripts/build.sh run --prod, ./gradlew bootRun) ----------------------------
# Ignored by `scripts/build.sh run` without --prod, which uses an embedded Postgres + Redis.
# POSTGRES_PASSWORD only takes effect when the Docker volume is first created; to change it later,
# run scripts/reset-demo.sh (wipes the data).

POSTGRES_DB=obsidian
POSTGRES_USER=obsidian
POSTGRES_PASSWORD=change-me
DB_URL=jdbc:postgresql://localhost:5432/obsidian
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- Encryption at rest (DEMO) -------------------------------------------------------------------

# Key for pgp_sym_encrypt (Gmail refresh tokens, TOTP secrets). Generate once and keep it: changing it
# makes stored Gmail connections unreadable (reconnect Gmail if that happens).
#   openssl rand -base64 32
# Blank: Gmail can't be connected (the dev runtime sets a throwaway key for itself).
APP_ENC_KEY=

# ---- VirusTotal (DEMO) -----------------------------------------------------------------------------

# https://www.virustotal.com → your profile → API key. Free tier: 4 requests/min, 500/day.
# Blank: every unknown URL and file stays PENDING (never reported as clean).
# Pre-warm the demo URLs: scripts/prewarm-vt.sh
VT_API_KEY=

# ---- Cloudflare Turnstile (DEMO) -------------------------------------------------------------------

# https://dash.cloudflare.com → Turnstile → Add widget. List every hostname you sign in from:
# localhost and/or obsidian.<your-domain>. A real key shows an error on any other hostname.
# For local testing, Cloudflare's test keys always pass:
#   site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
# Blank secret: Turnstile isn't checked (a warning is logged). Blank site key: no widget on /login.
# scripts/build.sh passes TURNSTILE_SITE_KEY to the dashboard, so it isn't needed in web-dashboard/.env.local.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Gmail (DEMO) ------------------------------------------------------------------------------------

# Google Cloud console → APIs & Services: enable the Gmail API, set up the consent screen (External,
# Testing, every Gmail address you'll connect as a test user, scopes gmail.readonly + gmail.modify),
# then create an OAuth client of type "Web application" with this authorized redirect URI:
#   ${PUBLIC_BASE_URL}/login/oauth2/code/google   e.g. http://localhost:3000/login/oauth2/code/google
# README.md → "Connect Gmail" has the full steps and the "Access blocked" fixes.
# Blank: Settings → Connect Gmail explains that Gmail isn't set up; no polling.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# ---- Code Guard GitHub App [P1, not built yet] ----------------------------------------------------------
# Never commit the private key .pem; point at it outside the repo.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
