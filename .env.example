# Copy to .env (gitignored) and fill in. Spring reads this file through
# spring.config.import, and docker compose reads it for the POSTGRES_* values.

# --- Origin -------------------------------------------------------------------
# The one public hostname (named Cloudflare tunnel), or http://localhost:3000 in
# the localhost fallback. Used for the Gmail OAuth redirect and WebAuthn origins.
PUBLIC_BASE_URL=http://localhost:3000
# WebAuthn relying party ID: the bare tunnel hostname, or localhost.
RP_ID=localhost

# --- Data ---------------------------------------------------------------------
POSTGRES_DB=obsidian
POSTGRES_USER=obsidian
POSTGRES_PASSWORD=change-me
DB_URL=jdbc:postgresql://localhost:5432/obsidian
REDIS_HOST=localhost
REDIS_PORT=6379

# Symmetric key for pgp_sym_encrypt (Gmail refresh tokens, TOTP secrets).
# Generate with: openssl rand -base64 32
APP_ENC_KEY=

# --- Threat intel -------------------------------------------------------------
# VirusTotal v3. Free tier: 4 requests/min, 500/day. Blank = every unknown
# indicator stays PENDING.
VT_API_KEY=

# --- Cloudflare Turnstile -----------------------------------------------------
# Blank secret = verification off (a warning is logged at startup).
# Test keys for localhost: site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Gmail (OAuth client of type "Web application") ----------------------------
# Authorized redirect URI: ${PUBLIC_BASE_URL}/login/oauth2/code/google
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# --- Code Guard [P1, not built yet] ---------------------------------------------
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
