# Copy to .env.local. Every value here is public (NEXT_PUBLIC_*) or local-only.

# "mock" (default) serves sample data in the browser; "live" calls Spring through /api.
NEXT_PUBLIC_API_MODE=mock

# Localhost fallback: where next.config.ts rewrites /api, /ws, /webauthn, /login/webauthn,
# /oauth2 and /login/oauth2. Unused behind the named tunnel.
SPRING_ORIGIN=http://localhost:8080

# Optional. Defaults to ws(s)://<this host>/ws/dashboard.
# NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws/dashboard

# Cloudflare Turnstile site key. scripts/build.sh fills it in from TURNSTILE_SITE_KEY in the root
# .env, so set it here only when running `npm run dev` yourself. Empty hides the widget; for
# localhost, Cloudflare's test key is 1x00000000000000000000AA.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
